# --- Supabase (PostgreSQL) ---
# En el panel: Project Settings → Database.
# 1) "Connection string" → URI → Modo "Transaction pooler" (puerto 6543) → DATABASE_URL
#    Asegurate de que incluya ?pgbouncer=true (Supabase suele agregarlo).
# 2) "Connection string" → URI → Modo "Session" o conexión directa al host db.xxx (puerto 5432) → DIRECT_URL
#    Las migraciones (prisma migrate deploy) usan DIRECT_URL.

DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# --- Desarrollo local con Postgres en Docker (sin Supabase) ---
# Levantá: docker compose -f docker-compose.postgres.yml up -d
# DATABASE_URL="postgresql://menu:menu@localhost:5432/menu_diario"
# DIRECT_URL="postgresql://menu:menu@localhost:5432/menu_diario"

# Sesión (obligatorio en prod): mínimo 32 caracteres aleatorios
SESSION_SECRET="cambiar-por-un-secreto-de-al-menos-32-caracteres-aleatorios"

# URL pública de la app (sin barra final). Vercel: https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional: cookie sin Secure en HTTPS raro / pruebas locales forzadas
# SESSION_INSECURE_LOCAL=1

# Opcional: correo del proveedor (pedidos)
NEXT_PUBLIC_CATERER_EMAIL="pedidos@proveedor.com"

# Seed opcional (npm run db:seed)
# SEED_ADMIN_EMAIL="admin@empresa.demo"
# SEED_ADMIN_PASSWORD="admin1234"
